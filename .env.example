# ============================================
# FreightOS — Environment Variables
# ============================================
# Copy this to .env.local and fill in values.

# NextAuth
NEXTAUTH_SECRET=generate-a-strong-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (for Google Sign-In)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Google Sheets API Service Account
# Create a service account in Google Cloud Console, share sheets with this email
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Shared Load Data Sheet ID (all users share this sheet)
LOAD_SHEET_ID=your-google-sheet-id-for-load-data

# App Data Sheet ID (for per-user data: prospects, customers, carriers, reminders, documents)
# Create a new Google Sheet, share with service account, paste its ID here
APP_DATA_SHEET_ID=your-google-sheet-id-for-app-data

# Groq API Key (free — tried first)
# Get at https://console.groq.com/keys
GROQ_API_KEY=gsk-your-groq-api-key

# OpenAI API Key (optional — tried second if Groq not set)
OPENAI_API_KEY=sk-your-key-optional

# Google Gemini API Key (optional — tried third if Groq and OpenAI not set)
# Get at https://aistudio.google.com/apikey — free tier available (60 req/min)
GEMINI_API_KEY=your-gemini-api-key-here
